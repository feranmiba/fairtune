# ==============================================================================
# FairTune Environment Configuration Template
# Copy this file to .env before starting the development environment.
# NEVER commit .env files containing real secrets to version control.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:4000

# Logging
LOG_LEVEL=info

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://fairtune:fairtune_dev_secret@localhost:5432/fairtune_dev?schema=public

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
# Generate secure random strings: openssl rand -base64 32
JWT_ACCESS_SECRET=replace_with_a_super_secret_jwt_access_key_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_super_secret_jwt_refresh_key_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# File Storage Configuration
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/contracts
MAX_FILE_SIZE_BYTES=10485760 # 10MB in bytes

# AI Integration
AI_PROVIDER=placeholder # Options: placeholder | openai | anthropic
AI_API_KEY=

# Stellar Blockchain Network Configuration
# Options: TESTNET | PUBLIC
STELLAR_NETWORK=TESTNET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Soroban Contract ID for the FairTune Royalty Escrow (deployed on Testnet)
STELLAR_ROYALTY_CONTRACT_ID=
# Platform public address (NEVER store private keys or secret seeds in environment or code)
STELLAR_PLATFORM_PUBLIC_KEY=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
